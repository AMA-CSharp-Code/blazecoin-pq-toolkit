diff --git a/src/test/pq_tests.cpp b/src/test/pq_tests.cpp
new file mode 100644
index 0000000..d93c5a9
--- /dev/null
+++ b/src/test/pq_tests.cpp
@@ -0,0 +1,160 @@
+// Copyright (c) 2026 The Blazecoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include "crypto/mldsa44.h"
+#include "policy/policy.h"
+#include "primitives/transaction.h"
+#include "script/interpreter.h"
+#include "script/pq.h"
+#include "script/script_error.h"
+#include "script/standard.h"
+#include "test/test_bitcoin.h"
+
+#include <boost/test/unit_test.hpp>
+
+/** The soft-fork sketch (script/pq.h) end to end: a key from a seed, a P2SH output whose redeem script is
+ *  <pqkh> OP_CHECKPQSIGVERIFY, a spend carrying the signature and key blob in canonical chunks. */
+BOOST_FIXTURE_TEST_SUITE(pq_tests, BasicTestingSetup)
+
+namespace {
+
+struct Spend {
+    std::vector<unsigned char> pk, sk, keyblob, sig;
+    CScript redeem, scriptPubKey, scriptSig;
+    CMutableTransaction tx;
+    CAmount amount{5 * COIN};
+
+    explicit Spend(unsigned char seedbyte = 0x11)
+    {
+        std::vector<unsigned char> seed(32, seedbyte);
+        BOOST_REQUIRE(mldsa44::KeyGenFromSeed(seed.data(), seed.size(), pk, sk));
+        keyblob = pq::PQKeyBlob(pk);
+        redeem = pq::GetPQRedeemScript(pq::PQKeyHash(keyblob));
+        scriptPubKey = GetScriptForDestination(CScriptID(redeem));
+
+        tx.nVersion = 1;
+        tx.vin.resize(1);
+        tx.vin[0].prevout = COutPoint(uint256S("0x1111111111111111111111111111111111111111111111111111111111111111"), 0);
+        tx.vin[0].nSequence = 0xfffffffe;
+        tx.vout.resize(1);
+        tx.vout[0].nValue = amount - 1000;
+        tx.vout[0].scriptPubKey = CScript() << OP_TRUE;
+        tx.nLockTime = 0;
+        Sign();
+    }
+
+    void Sign(CAmount sign_amount = -1)
+    {
+        const uint256 digest = pq::PQSigHash(CTransaction(tx), 0, sign_amount < 0 ? amount : sign_amount, redeem, nullptr);
+        BOOST_REQUIRE(mldsa44::Sign(sk.data(), sk.size(), digest.begin(), digest.size(),
+                                    reinterpret_cast<const unsigned char*>(pq::CTX_TX.data()), pq::CTX_TX.size(), sig));
+        Build();
+    }
+
+    void Build(const std::vector<unsigned char>* sig_override = nullptr, const std::vector<unsigned char>* keyblob_override = nullptr,
+               const size_t* sig_sizes = pq::PQ_SIG_CHUNK_SIZES, const size_t* kb_sizes = pq::PQ_KEYBLOB_CHUNK_SIZES)
+    {
+        scriptSig = CScript();
+        for (const auto& c : pq::SplitChunks(sig_override ? *sig_override : sig, sig_sizes, pq::PQ_SIG_CHUNKS)) scriptSig << c;
+        for (const auto& c : pq::SplitChunks(keyblob_override ? *keyblob_override : keyblob, kb_sizes, pq::PQ_KEYBLOB_CHUNKS)) scriptSig << c;
+        scriptSig << std::vector<unsigned char>(redeem.begin(), redeem.end());
+    }
+
+    ScriptError Verify(unsigned int flags, CAmount verify_amount = -1) const
+    {
+        ScriptError err = SCRIPT_ERR_OK;
+        const CScriptWitness witness;
+        VerifyScript(scriptSig, scriptPubKey, &witness, flags,
+                     MutableTransactionSignatureChecker(&tx, 0, verify_amount < 0 ? amount : verify_amount), &err);
+        return err;
+    }
+};
+
+const unsigned int NEW_RULES = STANDARD_SCRIPT_VERIFY_FLAGS; // includes SCRIPT_VERIFY_PQSIG
+const unsigned int OLD_NODE = SCRIPT_VERIFY_P2SH;            // consensus rules of a node without the soft fork
+
+} // namespace
+
+BOOST_AUTO_TEST_CASE(honest_spend_verifies_under_the_new_rules_and_is_true_to_an_old_node)
+{
+    Spend s;
+    BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_OK));
+    BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(MANDATORY_SCRIPT_VERIFY_FLAGS | SCRIPT_VERIFY_PQSIG)), ScriptErrorString(SCRIPT_ERR_OK));
+    // An old node executes a no-op and finds the 32-byte hash on top: true. Its policy discourages the NOP.
+    BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(OLD_NODE)), ScriptErrorString(SCRIPT_ERR_OK));
+    BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(OLD_NODE | SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_NOPS)), ScriptErrorString(SCRIPT_ERR_DISCOURAGE_UPGRADABLE_NOPS));
+    // Sizes, for the paper.
+    BOOST_CHECK_EQUAL(s.redeem.size(), pq::PQ_REDEEMSCRIPT_SIZE);
+    BOOST_CHECK(s.scriptSig.size() <= pq::MAX_STANDARD_PQ_SCRIPTSIG_SIZE);
+    BOOST_TEST_MESSAGE("PQ spend scriptSig bytes: " << s.scriptSig.size() << ", tx bytes: " << GetSerializeSize(CTransaction(s.tx), SER_NETWORK, PROTOCOL_VERSION) + s.scriptSig.size());
+    BOOST_CHECK(pq::IsPQSpendScriptSig(s.scriptSig));
+    BOOST_CHECK(!pq::IsPQSpendScriptSig(CScript() << OP_1));
+}
+
+BOOST_AUTO_TEST_CASE(every_mutation_fails_with_its_own_error)
+{
+    {   // a byte of the signature
+        Spend s; auto bad = s.sig; bad[100] ^= 0x01; s.Build(&bad);
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_PQ_SIG_INVALID));
+    }
+    {   // signed over a different amount
+        Spend s; s.Sign(s.amount + 1);
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_PQ_SIG_INVALID));
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES, s.amount + 1)), ScriptErrorString(SCRIPT_ERR_OK));
+    }
+    {   // another key behind the same hash commitment
+        Spend s, other(0x22); s.Build(nullptr, &other.keyblob);
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_PQ_KEYHASH_MISMATCH));
+    }
+    {   // a reserved algorithm id, committed to by the hash: refused as inactive
+        Spend s; s.keyblob[0] = 0x02; s.redeem = pq::GetPQRedeemScript(pq::PQKeyHash(s.keyblob));
+        s.scriptPubKey = GetScriptForDestination(CScriptID(s.redeem)); s.Build();
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_PQ_ALGO_INACTIVE));
+    }
+    {   // non-canonical chunking of the same signature bytes: refused (a third party cannot re-split to change the txid)
+        Spend s; static const size_t resplit[pq::PQ_SIG_CHUNKS] = {340, 520, 520, 520, 520}; s.Build(nullptr, nullptr, resplit);
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_PQ_SIG_INVALID));
+    }
+    {   // non-canonical key blob chunking
+        Spend s; static const size_t resplit[pq::PQ_KEYBLOB_CHUNKS] = {273, 520, 520}; s.Build(nullptr, nullptr, pq::PQ_SIG_CHUNK_SIZES, resplit);
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_PQ_PUBKEY_LENGTH));
+    }
+    {   // a chunk missing
+        Spend s; CScript sig2; auto chunks = pq::SplitChunks(s.sig, pq::PQ_SIG_CHUNK_SIZES, pq::PQ_SIG_CHUNKS);
+        for (size_t i = 1; i < chunks.size(); ++i) sig2 << chunks[i];
+        for (const auto& c : pq::SplitChunks(s.keyblob, pq::PQ_KEYBLOB_CHUNK_SIZES, pq::PQ_KEYBLOB_CHUNKS)) sig2 << c;
+        sig2 << std::vector<unsigned char>(s.redeem.begin(), s.redeem.end()); s.scriptSig = sig2;
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_PQ_STACK_SIZE));
+        BOOST_CHECK(!pq::IsPQSpendScriptSig(s.scriptSig));
+    }
+    {   // an extra push underneath: consensus-valid, policy refuses it (clean stack)
+        Spend s; CScript extra = CScript() << OP_1; extra.insert(extra.end(), s.scriptSig.begin(), s.scriptSig.end()); s.scriptSig = extra;
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_CLEANSTACK));
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(MANDATORY_SCRIPT_VERIFY_FLAGS | SCRIPT_VERIFY_PQSIG)), ScriptErrorString(SCRIPT_ERR_OK));
+    }
+    {   // an output changed after signing
+        Spend s; s.tx.vout[0].nValue -= 1;
+        BOOST_CHECK_EQUAL(ScriptErrorString(s.Verify(NEW_RULES)), ScriptErrorString(SCRIPT_ERR_PQ_SIG_INVALID));
+    }
+}
+
+BOOST_AUTO_TEST_CASE(digest_and_hash_helpers)
+{
+    Spend s;
+    const CTransaction tx(s.tx);
+    BOOST_CHECK(pq::PQSigHash(tx, 0, s.amount, s.redeem) != pq::PQSigHash(tx, 0, s.amount + 1, s.redeem));
+    PrecomputedTransactionData txdata(tx);
+    BOOST_CHECK(pq::PQSigHash(tx, 0, s.amount, s.redeem, &txdata) == pq::PQSigHash(tx, 0, s.amount, s.redeem, nullptr));
+    uint256 h;
+    BOOST_CHECK(pq::IsPQRedeemScript(s.redeem, &h));
+    BOOST_CHECK(h == pq::PQKeyHash(s.keyblob));
+    BOOST_CHECK(!pq::IsPQRedeemScript(CScript() << std::vector<unsigned char>(32, 1) << OP_NOP9));
+    // deterministic signing: the same digest signs to the same bytes
+    std::vector<unsigned char> again;
+    const uint256 digest = pq::PQSigHash(tx, 0, s.amount, s.redeem);
+    BOOST_REQUIRE(mldsa44::Sign(s.sk.data(), s.sk.size(), digest.begin(), 32, reinterpret_cast<const unsigned char*>(pq::CTX_TX.data()), pq::CTX_TX.size(), again));
+    BOOST_CHECK(again == s.sig);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
