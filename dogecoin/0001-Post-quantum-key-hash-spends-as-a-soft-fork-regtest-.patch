+#ifndef BITCOIN_CRYPTO_MLDSA44_H
+#define BITCOIN_CRYPTO_MLDSA44_H
+
+#include <cstddef>
+#include <vector>
+
+/** ML-DSA-44 (NIST FIPS 204) over the vendored pq-crystals reference implementation in crypto/mldsa/.
+ *  Deterministic signing (rnd = 0), seeded key generation, no RNG linked into consensus code.
+ *  Carried over from Blazecoin Core, where this wrapper has been live on mainnet since September 2026;
+ *  the Span type used there is replaced by pointer + length for this code base. */
+namespace mldsa44 {
+
+constexpr size_t PUBKEY_SIZE = 1312;
+constexpr size_t SECKEY_SIZE = 2560;
+constexpr size_t SIG_SIZE = 2420;
+constexpr size_t SEED_SIZE = 32;
+/** FIPS 204: the context string is at most 255 bytes. */
+constexpr size_t MAX_CTX_SIZE = 255;
+
+/** Expand a 32-byte seed into a key pair (FIPS 204 ML-DSA.KeyGen_internal). */
+bool KeyGenFromSeed(const unsigned char* seed32, size_t seedlen, std::vector<unsigned char>& pk, std::vector<unsigned char>& sk);
+
+/** Deterministic signature over msg under the context string ctx. */
+bool Sign(const unsigned char* sk, size_t sklen, const unsigned char* msg, size_t msglen,
+          const unsigned char* ctx, size_t ctxlen, std::vector<unsigned char>& sig);
+
+/** Verify sig over msg under ctx with public key pk. */
+bool Verify(const unsigned char* pk, size_t pklen, const unsigned char* msg, size_t msglen,
+            const unsigned char* ctx, size_t ctxlen, const unsigned char* sig, size_t siglen);
+
+} // namespace mldsa44
+
+#endif // BITCOIN_CRYPTO_MLDSA44_H
