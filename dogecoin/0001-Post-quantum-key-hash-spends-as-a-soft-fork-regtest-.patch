+
+class CTransaction;
+struct PrecomputedTransactionData;
+
+/** A post-quantum key-hash output for a legacy-script chain, as a SOFT FORK.
+ *
+ *  This is the Dogecoin sketch from the Blazecoin post-quantum field report (design comparison, section 6),
+ *  built for regtest. Blazecoin's deployed type (P2PQH) needed a hard fork because its 2,420-byte signature
+ *  cannot be pushed under the 520-byte element limit. Here the limit is left alone:
+ *
+ *    redeem script (34 bytes):  0x20 <pqkh:32> OP_CHECKPQSIGVERIFY      (OP_NOP10, 0xb9, redefined)
+ *    output:                    the redeem script behind ordinary P2SH, so any wallet can pay to it today
+ *    scriptSig (9 pushes):      <sig 520> <sig 520> <sig 520> <sig 520> <sig 340>
+ *                               <keyblob 520> <keyblob 520> <keyblob 273> <redeem script 34>
+ *
+ *  The opcode reassembles the chunks (sizes fixed, so a third party cannot re-split them and change the txid),
+ *  checks TaggedHash("Dogecoin/PQKH/v1", keyblob) == pqkh, checks the algorithm byte and lengths, and verifies
+ *  ML-DSA-44 (FIPS 204) over a BIP-143-shaped digest that commits to the amount, under the context string
+ *  "dogecoin-tx-v1". A node without the rule executes a no-op and finds the 32-byte hash on top of the stack,
+ *  which is true: the usual pre-activation view of a soft-forked output type. */
+namespace pq {
+
+constexpr unsigned char PQ_ALGO_MLDSA44 = 0x01;
+
+constexpr size_t PQ_KEYHASH_SIZE = 32;
+constexpr size_t PQ_MLDSA44_PUBKEY_SIZE = 1312;
+constexpr size_t PQ_MLDSA44_SIG_SIZE = 2420;
+/** algorithm byte + public key */
+constexpr size_t PQ_MLDSA44_KEYBLOB_SIZE = 1 + PQ_MLDSA44_PUBKEY_SIZE;
+/** 0x20 <32> OP_CHECKPQSIGVERIFY */
+constexpr size_t PQ_REDEEMSCRIPT_SIZE = 2 + PQ_KEYHASH_SIZE;
+/** The only sighash type: SIGHASH_ALL. */
+constexpr uint32_t PQ_SIGHASH_ALL = 1;
+/** Policy: the nine-push spend is 3,792 bytes (2,420 + 1,313 + 34 of data, 25 of push prefixes); a little room. */
+constexpr size_t MAX_STANDARD_PQ_SCRIPTSIG_SIZE = 3800;
+
+/** Canonical chunking of the two elements under MAX_SCRIPT_ELEMENT_SIZE (520). */
+constexpr size_t PQ_SIG_CHUNKS = 5;
+constexpr size_t PQ_KEYBLOB_CHUNKS = 3;
+constexpr size_t PQ_STACK_ITEMS = PQ_SIG_CHUNKS + PQ_KEYBLOB_CHUNKS; // beneath the hash: 8
+extern const size_t PQ_SIG_CHUNK_SIZES[PQ_SIG_CHUNKS];         // 520 520 520 520 340
+extern const size_t PQ_KEYBLOB_CHUNK_SIZES[PQ_KEYBLOB_CHUNKS]; // 520 520 273
+
+const std::string TAG_PQKH = "Dogecoin/PQKH/v1";
+const std::string TAG_SIGHASH = "Dogecoin/PQSig/v1";
+/** FIPS 204 context string for transaction signatures. */
+const std::string CTX_TX = "dogecoin-tx-v1";
+
+/** SHA256(SHA256(tag) || SHA256(tag) || data): the BIP-340 tagged hash, single SHA256. */
+uint256 TaggedSHA256(const std::string& tag, const unsigned char* data, size_t len);
+
+/** pqkh = TaggedHash("Dogecoin/PQKH/v1", keyblob). */
+uint256 PQKeyHash(const std::vector<unsigned char>& keyblob);
+
+/** keyblob = 0x01 || pubkey. */
+std::vector<unsigned char> PQKeyBlob(const std::vector<unsigned char>& pubkey);
+
+/** 0x20 <pqkh> OP_CHECKPQSIGVERIFY */
+CScript GetPQRedeemScript(const uint256& pqkh);
+
+/** Exact test for the 34-byte redeem script. */
+bool IsPQRedeemScript(const CScript& script, uint256* pqkh = nullptr);
+
+/** Split an element into the canonical chunks (for spenders and tests). */
+std::vector<std::vector<unsigned char> > SplitChunks(const std::vector<unsigned char>& data, const size_t* sizes, size_t n);
+
+/** Join n stack items whose sizes must equal sizes[]; false if any size differs. */
+bool JoinChunks(const std::vector<std::vector<unsigned char> >& items, const size_t* sizes, size_t n, std::vector<unsigned char>& out);
+
+/** The digest for input nIn: TaggedHash("Dogecoin/PQSig/v1", BIP-143-shaped preimage committing to the
+ *  amount and the 34-byte redeem script as scriptCode). */
+uint256 PQSigHash(const CTransaction& tx, unsigned int nIn, const CAmount& amount, const CScript& scriptCode, const PrecomputedTransactionData* cache = nullptr);
+
+/** Policy helper: a push-only scriptSig of exactly nine pushes whose last push is a PQ redeem script. */
+bool IsPQSpendScriptSig(const CScript& scriptSig);
+
+} // namespace pq
+
+#endif // BITCOIN_SCRIPT_PQ_H
