index 0000000..b818e94
--- /dev/null
+++ b/qa/rpc-tests/pqsig-softfork.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Blazecoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""The post-quantum key-hash soft fork (OP_CHECKPQSIGVERIFY, src/script/pq.h) on regtest, end to end.
+
+Activates DEPLOYMENT_PQSIG through version bits, pays into a P2SH output whose redeem script is
+<pqkh> OP_CHECKPQSIGVERIFY using the ordinary wallet, then spends it with a transaction built and signed here
+in Python (dilithium-py, pure Python ML-DSA-44) so that the node is the only thing under test. Then the
+mutations a node must refuse, and the policy limit on the scriptSig size.
+"""
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import *
+from test_framework.mininode import CTransaction, CTxIn, CTxOut, COutPoint, ToHex, FromHex, hash256, ser_uint256, ser_string, uint256_from_str
+from test_framework.script import CScript, OP_NOP10, OP_TRUE
+
+import hashlib
+import struct
+import time
+
+from dilithium_py.ml_dsa import ML_DSA_44
+
+TAG_PQKH = b"Dogecoin/PQKH/v1"
+TAG_SIGHASH = b"Dogecoin/PQSig/v1"
+CTX_TX = b"dogecoin-tx-v1"
+SIG_CHUNKS = (520, 520, 520, 520, 340)
+KEYBLOB_CHUNKS = (520, 520, 273)
+
+
+def tagged_sha256(tag, data):
+    t = hashlib.sha256(tag).digest()
+    return hashlib.sha256(t + t + data).digest()
+
+
+def pq_sighash(tx, in_idx, amount, redeem_script):
+    """TaggedHash("Dogecoin/PQSig/v1", the BIP-143-shaped preimage with SIGHASH_ALL)."""
+    hash_prevouts = hash256(b"".join(i.prevout.serialize() for i in tx.vin))
+    hash_sequence = hash256(b"".join(struct.pack("<I", i.nSequence) for i in tx.vin))
+    hash_outputs = hash256(b"".join(o.serialize() for o in tx.vout))
+    ss = struct.pack("<i", tx.nVersion)
+    ss += hash_prevouts + hash_sequence
+    ss += tx.vin[in_idx].prevout.serialize()
+    ss += ser_string(redeem_script)
+    ss += struct.pack("<q", amount)
+    ss += struct.pack("<I", tx.vin[in_idx].nSequence)
+    ss += hash_outputs
+    ss += struct.pack("<I", tx.nLockTime)
+    ss += struct.pack("<I", 1)
+    return tagged_sha256(TAG_SIGHASH, ss)
+
+
+def chunks(data, sizes):
+    out, pos = [], 0
+    for s in sizes:
+        out.append(data[pos:pos + s])
+        pos += s
+    assert pos == len(data), (pos, len(data))
+    return out
+
+
+class PQKey:
+    def __init__(self):
+        self.pk, self.sk = ML_DSA_44.keygen()
+        self.keyblob = b"\x01" + self.pk
+        self.pqkh = tagged_sha256(TAG_PQKH, self.keyblob)
+        self.redeem = CScript([self.pqkh, OP_NOP10])
+
+    def sign(self, digest):
+        return ML_DSA_44.sign(self.sk, digest, ctx=CTX_TX, deterministic=True)
+
+    def script_sig(self, sig, keyblob=None, sig_sizes=SIG_CHUNKS, extra_push=None):
+        items = chunks(sig, sig_sizes) + chunks(keyblob or self.keyblob, KEYBLOB_CHUNKS) + [bytes(self.redeem)]
+        if extra_push is not None:
+            items = [extra_push] + items
+        return CScript(items)
+
+
+class PQSigSoftForkTest(BitcoinTestFramework):
+    def __init__(self):
+        super().__init__()
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+
+    def setup_network(self):
+        # node 0 enforces standardness (the policy under test); node 1 is a plain regtest node
+        self.nodes = start_nodes(self.num_nodes, self.options.tmpdir, [["-acceptnonstdtxn=0"], []])
+        connect_nodes(self.nodes[0], 1)
+        self.is_network_split = False
+        self.sync_all()
+
+    def status(self):
+        return self.nodes[0].getblockchaininfo()["bip9_softforks"]["pqsig"]["status"]
+
+    def fund(self, key, amount):
+        """Pay amount into the key's P2SH output with the wallet; return (txid, vout)."""
+        addr = self.nodes[0].decodescript(bytes_to_hex_str(bytes(key.redeem)))["p2sh"]
+        txid = self.nodes[0].sendtoaddress(addr, amount)
+        self.nodes[0].generate(1)
+        self.sync_all()
+        tx = self.nodes[0].getrawtransaction(txid, 1)
+        p2sh_hex = self.nodes[0].validateaddress(addr)["scriptPubKey"]
+        vout = [o["n"] for o in tx["vout"] if o["scriptPubKey"]["hex"] == p2sh_hex][0]
+        return txid, vout
+
+    def spend_tx(self, txid, vout, amount, fee):
+        tx = CTransaction()
+        tx.nVersion = 1
+        tx.vin = [CTxIn(COutPoint(int(txid, 16), vout), b"", 0xfffffffe)]
+        dest = self.nodes[0].validateaddress(self.nodes[0].getnewaddress())["scriptPubKey"]
+        tx.vout = [CTxOut(int((amount - fee) * COIN), hex_str_to_bytes(dest))]
+        tx.nLockTime = 0
+        return tx
+
+    def run_test(self):
+        node = self.nodes[0]
+
+        # 1. Activation through version bits: 720-block periods on regtest; start time 0.
+        assert_equal(self.status(), "defined")
+        node.generate(720)
+        assert_equal(self.status(), "started")
+        node.generate(720)
+        assert_equal(self.status(), "locked_in")
+        node.generate(720)
+        assert_equal(self.status(), "active")
+        self.sync_all()
+        self.log_line("pqsig active at height %d" % node.getblockcount())
+
+        # 2. The honest spend, signed in Python, accepted by both nodes and mined.
+        key = PQKey()
+        amount = 100
+        txid, vout = self.fund(key, amount)
+        tx = self.spend_tx(txid, vout, amount, fee=5)
+        digest = pq_sighash(tx, 0, amount * COIN, bytes(key.redeem))
+        sig = key.sign(digest)
+        assert_equal(len(sig), 2420)
+        tx.vin[0].scriptSig = key.script_sig(sig)
+        raw = ToHex(tx)
+        spend_txid = node.sendrawtransaction(raw)
+        self.sync_all()
+        assert spend_txid in self.nodes[1].getrawmempool()
+        node.generate(1)
+        self.sync_all()
+        mined = node.getrawtransaction(spend_txid, 1)
+        assert_equal(mined["confirmations"], 1)
+        self.log_line("PQ spend mined: scriptSig %d bytes, tx %d bytes, fee %s DOGE" % (len(tx.vin[0].scriptSig), len(raw) // 2, 5))
+
+        # 3. A P2PKH spend of the same shape, for the size comparison.
+        a = node.getnewaddress()
+        t2 = node.sendtoaddress(a, 10)
+        node.generate(1)
+        classic = node.getrawtransaction(t2, 1)
+        self.log_line("classic wallet tx for comparison: %d bytes, %d inputs" % (classic["size"], len(classic["vin"])))
+
+        # 4. Mutations: each refused by the node with the opcode's own error.
+        key2 = PQKey()
+        txid, vout = self.fund(key2, amount)
+        tx = self.spend_tx(txid, vout, amount, fee=5)
+        digest = pq_sighash(tx, 0, amount * COIN, bytes(key2.redeem))
+        sig = key2.sign(digest)
+
+        bad = bytearray(sig); bad[7] ^= 0x01
+        tx.vin[0].scriptSig = key2.script_sig(bytes(bad))
+        assert_raises_jsonrpc(-26, "PQ signature is invalid", node.sendrawtransaction, ToHex(tx))
+
+        tx.vin[0].scriptSig = key2.script_sig(sig, sig_sizes=(340, 520, 520, 520, 520))   # same bytes, other split
+        assert_raises_jsonrpc(-26, "PQ signature is invalid", node.sendrawtransaction, ToHex(tx))
+
+        tx.vin[0].scriptSig = key2.script_sig(sig, keyblob=key.keyblob)                    # another key behind the hash
+        assert_raises_jsonrpc(-26, "does not hash to the committed key hash", node.sendrawtransaction, ToHex(tx))
+
+        tx.vin[0].scriptSig = key2.script_sig(key.sign(digest))                           # right digest, wrong signer
+        assert_raises_jsonrpc(-26, "PQ signature is invalid", node.sendrawtransaction, ToHex(tx))
+
+        # 5. Policy: ten pushes are not the standard shape, so the 1650-byte limit applies again on node 0,
+        #    while node 1 (accepts non-standard) rejects it on the clean-stack rule instead.
+        tx.vin[0].scriptSig = key2.script_sig(sig, extra_push=b"\x01")
+        assert_raises_jsonrpc(-26, "scriptsig-size", node.sendrawtransaction, ToHex(tx))
+        assert_raises_jsonrpc(-26, "", self.nodes[1].sendrawtransaction, ToHex(tx))
+
+        # 6. And the honest spend of this second key still goes through after all that.
+        tx.vin[0].scriptSig = key2.script_sig(sig)
+        spend2 = node.sendrawtransaction(ToHex(tx))
+        node.generate(1)
+        assert_equal(node.getrawtransaction(spend2, 1)["confirmations"], 1)
+
+    def log_line(self, s):
+        print("PQSIG: " + s)
+
+
+if __name__ == '__main__':
+    PQSigSoftForkTest().main()
