diff --git a/src/script/pq.cpp b/src/script/pq.cpp
new file mode 100644
index 0000000..a15855a
--- /dev/null
+++ b/src/script/pq.cpp
@@ -0,0 +1,145 @@
+// Copyright (c) 2026 The Blazecoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <script/pq.h>
+
+#include <crypto/sha256.h>
+#include <hash.h>
+#include <primitives/transaction.h>
+#include <script/interpreter.h>
+#include <streams.h>
+#include <version.h>
+
+#include <cassert>
+
+namespace pq {
+
+const size_t PQ_SIG_CHUNK_SIZES[PQ_SIG_CHUNKS] = {520, 520, 520, 520, 340};
+const size_t PQ_KEYBLOB_CHUNK_SIZES[PQ_KEYBLOB_CHUNKS] = {520, 520, 273};
+
+static_assert(520 * 4 + 340 == PQ_MLDSA44_SIG_SIZE, "signature chunking");
+static_assert(520 * 2 + 273 == PQ_MLDSA44_KEYBLOB_SIZE, "key blob chunking");
+static_assert(520 == MAX_SCRIPT_ELEMENT_SIZE, "chunk size must be the element limit");
+
+uint256 TaggedSHA256(const std::string& tag, const unsigned char* data, size_t len)
+{
+    unsigned char taghash[CSHA256::OUTPUT_SIZE];
+    CSHA256().Write(reinterpret_cast<const unsigned char*>(tag.data()), tag.size()).Finalize(taghash);
+    uint256 out;
+    CSHA256().Write(taghash, sizeof(taghash)).Write(taghash, sizeof(taghash)).Write(data, len).Finalize(out.begin());
+    return out;
+}
+
+uint256 PQKeyHash(const std::vector<unsigned char>& keyblob)
+{
+    return TaggedSHA256(TAG_PQKH, keyblob.data(), keyblob.size());
+}
+
+std::vector<unsigned char> PQKeyBlob(const std::vector<unsigned char>& pubkey)
+{
+    std::vector<unsigned char> blob;
+    blob.reserve(1 + pubkey.size());
+    blob.push_back(PQ_ALGO_MLDSA44);
+    blob.insert(blob.end(), pubkey.begin(), pubkey.end());
+    return blob;
+}
+
+CScript GetPQRedeemScript(const uint256& pqkh)
+{
+    return CScript() << std::vector<unsigned char>(pqkh.begin(), pqkh.end()) << OP_CHECKPQSIGVERIFY;
+}
+
+bool IsPQRedeemScript(const CScript& script, uint256* pqkh)
+{
+    if (script.size() != PQ_REDEEMSCRIPT_SIZE || script[0] != PQ_KEYHASH_SIZE || script[PQ_REDEEMSCRIPT_SIZE - 1] != OP_CHECKPQSIGVERIFY) {
+        return false;
+    }
+    if (pqkh) {
+        std::copy(script.begin() + 1, script.begin() + 1 + PQ_KEYHASH_SIZE, pqkh->begin());
+    }
+    return true;
+}
+
+std::vector<std::vector<unsigned char> > SplitChunks(const std::vector<unsigned char>& data, const size_t* sizes, size_t n)
+{
+    std::vector<std::vector<unsigned char> > out;
+    size_t pos = 0;
+    for (size_t i = 0; i < n; ++i) {
+        const size_t take = std::min(sizes[i], data.size() - std::min(pos, data.size()));
+        out.push_back(std::vector<unsigned char>(data.begin() + pos, data.begin() + pos + take));
+        pos += take;
+    }
+    return out;
+}
+
+bool JoinChunks(const std::vector<std::vector<unsigned char> >& items, const size_t* sizes, size_t n, std::vector<unsigned char>& out)
+{
+    out.clear();
+    if (items.size() != n) return false;
+    for (size_t i = 0; i < n; ++i) {
+        if (items[i].size() != sizes[i]) return false;
+        out.insert(out.end(), items[i].begin(), items[i].end());
+    }
+    return true;
+}
+
+uint256 PQSigHash(const CTransaction& tx, unsigned int nIn, const CAmount& amount, const CScript& scriptCode, const PrecomputedTransactionData* cache)
+{
+    assert(nIn < tx.vin.size());
+
+    uint256 hashPrevouts, hashSequence, hashOutputs;
+    if (cache) {
+        hashPrevouts = cache->hashPrevouts;
+        hashSequence = cache->hashSequence;
+        hashOutputs = cache->hashOutputs;
+    } else {
+        {
+            CHashWriter ss(SER_GETHASH, 0);
+            for (const auto& txin : tx.vin) ss << txin.prevout;
+            hashPrevouts = ss.GetHash();
+        }
+        {
+            CHashWriter ss(SER_GETHASH, 0);
+            for (const auto& txin : tx.vin) ss << txin.nSequence;
+            hashSequence = ss.GetHash();
+        }
+        {
+            CHashWriter ss(SER_GETHASH, 0);
+            for (const auto& txout : tx.vout) ss << txout;
+            hashOutputs = ss.GetHash();
+        }
+    }
+
+    // The BIP-143 shape, SIGHASH_ALL only, then one tagged SHA256 over the preimage.
+    CDataStream ss(SER_GETHASH, 0);
+    ss << tx.nVersion;
+    ss << hashPrevouts;
+    ss << hashSequence;
+    ss << tx.vin[nIn].prevout;
+    ss << static_cast<const CScriptBase&>(scriptCode); // varint length + the 34-byte redeem script
+    ss << amount;
+    ss << tx.vin[nIn].nSequence;
+    ss << hashOutputs;
+    ss << tx.nLockTime;
+    ss << PQ_SIGHASH_ALL;
+    return TaggedSHA256(TAG_SIGHASH, reinterpret_cast<const unsigned char*>(ss.data()), ss.size());
+}
+
+bool IsPQSpendScriptSig(const CScript& scriptSig)
+{
+    if (!scriptSig.IsPushOnly()) return false;
+    std::vector<std::vector<unsigned char> > pushes;
+    CScript::const_iterator pc = scriptSig.begin();
+    opcodetype opcode;
+    std::vector<unsigned char> data;
+    while (pc < scriptSig.end()) {
+        if (!scriptSig.GetOp(pc, opcode, data)) return false;
+        pushes.push_back(data);
+    }
+    if (pushes.size() != PQ_STACK_ITEMS + 1) return false;
+    const CScript redeem(pushes.back().begin(), pushes.back().end());
+    return IsPQRedeemScript(redeem);
+}
+
+} // namespace pq
