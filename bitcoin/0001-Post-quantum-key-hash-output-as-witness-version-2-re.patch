new file mode 100644
index 0000000..016d311
--- /dev/null
+++ b/src/script/pq.h
@@ -0,0 +1,70 @@
+// Copyright (c) 2026 The Blazecoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_SCRIPT_PQ_H
+#define BITCOIN_SCRIPT_PQ_H
+
+#include <script/script.h>
+#include <uint256.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string>
+#include <vector>
+
+struct PrecomputedTransactionData;
+
+/** A post-quantum key-hash output as a new witness version: the regtest build of section 4 of
+ *  "Carrying a deployed ML-DSA-44 output type to Bitcoin" (Blazecoin post-quantum field report).
+ *
+ *    scriptPubKey (34 bytes):  OP_2 <32-byte key hash>        witness version 2, program = TaggedHash("PQKeyHash", keyblob)
+ *    witness (2 items):        <signature 2420> <keyblob 1313>  keyblob = algorithm byte 0x01 || ML-DSA-44 public key
+ *    message:                  the BIP-341 message with ext_flag 2 and SIGHASH_DEFAULT only, under the tag "PQSighash"
+ *    verify:                   ML-DSA-44 (FIPS 204), deterministic, context string "bitcoin-pq-v1"
+ *
+ *  Soft fork: a node without the rule treats an unknown witness version as anyone-can-spend. Not a proposal and
+ *  not scheduled on any live network; it exists to measure the design on Bitcoin's own limits. */
+namespace pq {
+
+constexpr int PQ_WITNESS_VERSION = 2;
+constexpr unsigned char PQ_ALGO_MLDSA44 = 0x01;
+
+constexpr size_t PQ_KEYHASH_SIZE = 32;
+constexpr size_t PQ_MLDSA44_PUBKEY_SIZE = 1312;
+constexpr size_t PQ_MLDSA44_SIG_SIZE = 2420;
+constexpr size_t PQ_MLDSA44_KEYBLOB_SIZE = 1 + PQ_MLDSA44_PUBKEY_SIZE;
+/** Serialized witness of a spend: item count (1) + compactsize(2420) (3) + 2420 + compactsize(1313) (3) + 1313. */
+constexpr size_t PQ_WITNESS_SERIALIZED_SIZE = 1 + 3 + PQ_MLDSA44_SIG_SIZE + 3 + PQ_MLDSA44_KEYBLOB_SIZE;
+
+const std::string TAG_PQKH = "PQKeyHash";
+const std::string TAG_SIGHASH = "PQSighash";
+/** FIPS 204 context string for transaction signatures. */
+const std::string CTX_TX = "bitcoin-pq-v1";
+inline std::span<const unsigned char> CtxTx() { return {reinterpret_cast<const unsigned char*>(CTX_TX.data()), CTX_TX.size()}; }
+
+/** TaggedHash("PQKeyHash", keyblob), single SHA256 (BIP-340 tagged hash). */
+uint256 PQKeyHash(std::span<const unsigned char> keyblob);
+
+/** keyblob = 0x01 || pubkey. */
+std::vector<unsigned char> PQKeyBlob(std::span<const unsigned char> pubkey);
+
+/** OP_2 <32-byte key hash> */
+CScript GetScriptForPQWitness(const uint256& pqkh);
+
+/** True for witness version 2 with a 32-byte program. */
+bool IsPQWitnessProgram(int version, const std::vector<unsigned char>& program);
+
+/** True for exactly the scriptPubKey GetScriptForPQWitness builds: OP_2 followed by one 32-byte push (34 bytes).
+ *  The one place the output's byte shape is stated, for code that has only the script (transaction precomputation). */
+bool IsPQScriptPubKey(const CScript& script);
+
+/** The signed message: BIP-341 layout, epoch 0, hash type SIGHASH_DEFAULT (0), spend_type 4 (ext_flag 2, no annex),
+ *  tagged "PQSighash". False when the precomputed BIP-341 data or the spent outputs are missing. */
+template <class T>
+bool SignatureHashPQ(uint256& hash_out, const T& tx_to, uint32_t in_pos, const PrecomputedTransactionData& cache);
+
+} // namespace pq
+
+#endif // BITCOIN_SCRIPT_PQ_H
