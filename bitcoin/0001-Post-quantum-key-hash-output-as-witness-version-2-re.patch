new file mode 100644
index 0000000..a74747c
--- /dev/null
+++ b/src/script/pq.cpp
@@ -0,0 +1,77 @@
+// Copyright (c) 2026 The Blazecoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <script/pq.h>
+
+#include <hash.h>
+#include <primitives/transaction.h>
+#include <script/interpreter.h>
+#include <uint256.h>
+
+#include <cassert>
+
+namespace pq {
+
+uint256 PQKeyHash(std::span<const unsigned char> keyblob)
+{
+    HashWriter ss{TaggedHash(TAG_PQKH)};
+    ss.write(std::as_bytes(keyblob));
+    return ss.GetSHA256();
+}
+
+std::vector<unsigned char> PQKeyBlob(std::span<const unsigned char> pubkey)
+{
+    std::vector<unsigned char> blob;
+    blob.reserve(1 + pubkey.size());
+    blob.push_back(PQ_ALGO_MLDSA44);
+    blob.insert(blob.end(), pubkey.begin(), pubkey.end());
+    return blob;
+}
+
+CScript GetScriptForPQWitness(const uint256& pqkh)
+{
+    return CScript() << OP_2 << std::vector<unsigned char>(pqkh.begin(), pqkh.end());
+}
+
+bool IsPQWitnessProgram(int version, const std::vector<unsigned char>& program)
+{
+    return version == PQ_WITNESS_VERSION && program.size() == PQ_KEYHASH_SIZE;
+}
+
+bool IsPQScriptPubKey(const CScript& script)
+{
+    int version;
+    std::vector<unsigned char> program;
+    return script.IsWitnessProgram(version, program) && IsPQWitnessProgram(version, program);
+}
+
+template <class T>
+bool SignatureHashPQ(uint256& hash_out, const T& tx_to, uint32_t in_pos, const PrecomputedTransactionData& cache)
+{
+    assert(in_pos < tx_to.vin.size());
+    if (!(cache.m_bip341_taproot_ready && cache.m_spent_outputs_ready)) return false;
+
+    HashWriter ss{TaggedHash(TAG_SIGHASH)};
+    // Epoch and hash type: one mode, SIGHASH_DEFAULT (no sighash byte; the signature has an exact size).
+    ss << uint8_t{0};
+    ss << uint8_t{SIGHASH_DEFAULT};
+    // Transaction level data, as BIP-341.
+    ss << tx_to.version;
+    ss << tx_to.nLockTime;
+    ss << cache.m_prevouts_single_hash;
+    ss << cache.m_spent_amounts_single_hash;
+    ss << cache.m_spent_scripts_single_hash;
+    ss << cache.m_sequences_single_hash;
+    ss << cache.m_outputs_single_hash;
+    // spend_type = (ext_flag << 1) + annex_present; ext_flag 2 marks this witness version, no annex is defined.
+    ss << uint8_t{(2 << 1) + 0};
+    ss << in_pos;
+    hash_out = ss.GetSHA256();
+    return true;
+}
+
+template bool SignatureHashPQ(uint256& hash_out, const CTransaction& tx_to, uint32_t in_pos, const PrecomputedTransactionData& cache);
+template bool SignatureHashPQ(uint256& hash_out, const CMutableTransaction& tx_to, uint32_t in_pos, const PrecomputedTransactionData& cache);
+
+} // namespace pq
