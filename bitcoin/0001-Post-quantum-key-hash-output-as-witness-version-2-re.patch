+#!/usr/bin/env python3
+# Copyright (c) 2026 The Blazecoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""The post-quantum key-hash witness version (src/script/pq.h) on regtest, end to end.
+
+node0 runs the new rule (regtest: always active). node1 is started with the deployment disabled, so it stands for
+every node that has not upgraded. The spend is built and signed here with dilithium-py (pure Python ML-DSA-44),
+so the node is the only thing under test.
+
+Shows: the honest spend relays and mines on node0 and measures 3,904 WU per input; node1 sees the same spend as
+an unknown witness version (anyone-can-spend, discouraged by policy) and accepts a block carrying a BAD signature
+that node0 rejects; the mutations node0 refuses with their own errors; the dust rule priced from the real spend.
+"""
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, assert_raises_rpc_error
+from test_framework.messages import COIN, CTransaction, CTxIn, CTxOut, COutPoint, CTxInWitness, ser_string, sha256
+from test_framework.script import CScript, OP_2, TaggedHash, BIP341_sha_prevouts, BIP341_sha_amounts, BIP341_sha_scriptpubkeys, BIP341_sha_sequences, BIP341_sha_outputs
+from test_framework.blocktools import create_block, create_coinbase, add_witness_commitment
+from test_framework.wallet import MiniWallet
+
+from dilithium_py.ml_dsa import ML_DSA_44
+
+TAG_PQKH = "PQKeyHash"
+TAG_SIGHASH = "PQSighash"
+CTX_TX = b"bitcoin-pq-v1"
+
+
+def pq_sighash(tx, spent_utxos, input_index):
+    """TaggedHash("PQSighash", BIP-341 message with hash type 0 and spend_type 4 (ext_flag 2, no annex))."""
+    ss = bytes([0, 0])  # epoch, SIGHASH_DEFAULT
+    ss += tx.version.to_bytes(4, "little")
+    ss += tx.nLockTime.to_bytes(4, "little")
+    ss += BIP341_sha_prevouts(tx)
+    ss += BIP341_sha_amounts(spent_utxos)
+    ss += BIP341_sha_scriptpubkeys(spent_utxos)
+    ss += BIP341_sha_sequences(tx)
+    ss += BIP341_sha_outputs(tx)
+    ss += bytes([2 << 1])
+    ss += input_index.to_bytes(4, "little")
+    assert_equal(len(ss), 2 + 4 + 4 + 32 * 5 + 1 + 4)
+    return TaggedHash(TAG_SIGHASH, ss)
+
+
+class PQKey:
+    def __init__(self):
+        self.pk, self.sk = ML_DSA_44.keygen()
+        self.keyblob = b"\x01" + self.pk
+        self.program = TaggedHash(TAG_PQKH, self.keyblob)
+        self.spk = CScript([OP_2, self.program])
+
+    def sign(self, digest):
+        return ML_DSA_44.sign(self.sk, digest, ctx=CTX_TX, deterministic=True)
+
+
+class PQWitnessTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+        # node1: the deployment never activates (start 1, timeout 1 -> failed), i.e. a node without the soft fork
+        self.extra_args = [[], ["-vbparams=pq:1:1"]]
+
+    def fund(self, key, amount_sat):
+        res = self.wallet.send_to(from_node=self.nodes[0], scriptPubKey=key.spk, amount=amount_sat)
+        self.generate(self.nodes[0], 1)   # generate() syncs both nodes, so node1 knows the funding output too
+        return res["txid"], res["sent_vout"]
+
+    def spend(self, key, amount_sat, fee_sat=20000, flip_sig_byte=None, keyblob=None):
+        txid, vout = self.fund(key, amount_sat)
+        tx = CTransaction()
+        tx.version = 2
+        tx.vin = [CTxIn(COutPoint(int(txid, 16), vout), b"", 0xfffffffd)]
+        tx.vout = [CTxOut(amount_sat - fee_sat, self.wallet.get_output_script())]
+        tx.nLockTime = 0
+        spent = [CTxOut(amount_sat, key.spk)]
+        sig = key.sign(pq_sighash(tx, spent, 0))
+        assert_equal(len(sig), 2420)
+        if flip_sig_byte is not None:
+            b = bytearray(sig); b[flip_sig_byte] ^= 0x01; sig = bytes(b)
+        tx.wit.vtxinwit = [CTxInWitness()]
+        tx.wit.vtxinwit[0].scriptWitness.stack = [sig, keyblob or key.keyblob]
+
+        return tx
+
+    def block_with(self, node, tx):
+        tip = node.getbestblockhash()
+        height = node.getblockcount() + 1
+        block = create_block(int(tip, 16), create_coinbase(height), ntime=node.getblock(tip)["time"] + 1, txlist=[tx])
+        add_witness_commitment(block)
+        block.solve()
+        return block
+
+    def run_test(self):
+        node0, node1 = self.nodes
+        self.wallet = MiniWallet(node0)
+        self.generate(self.wallet, 110)
+        info = node0.getdeploymentinfo()["deployments"]["pq"]
+        assert_equal(info["active"], True)
+        assert_equal(node1.getdeploymentinfo()["deployments"]["pq"]["active"], False)
+
+        # 1. The honest spend: relays and mines on node0; node1 sees an unknown witness version and refuses to relay it.
+        key = PQKey()
+        tx = self.spend(key, 2 * COIN)
+        node1_view = node1.testmempoolaccept([tx.serialize().hex()])[0]
+        assert_equal(node1_view["allowed"], False)
+        # the old-rules node refuses it at the policy door: an undefined witness program is non-standard
+        assert "nonstandard-inputs" in node1_view["reject-reason"] or "reserved for soft-fork upgrades" in node1_view.get("reject-details", ""), node1_view
+        txid = node0.sendrawtransaction(tx.serialize().hex())
+        blockhash = self.generate(node0, 1)[0]
+        mined = node0.getrawtransaction(txid, True, blockhash)   # no -txindex: name the block
+        assert_equal(mined["confirmations"], 1)
+        witness_bytes = len(ser_string(tx.wit.vtxinwit[0].scriptWitness.stack[0])) + len(ser_string(tx.wit.vtxinwit[0].scriptWitness.stack[1])) + 1
+        self.log.info("PQ witness spend mined: weight %d WU, vsize %d vB, witness %d bytes" % (mined["weight"], mined["vsize"], witness_bytes))
+        assert_equal(witness_bytes, 3740)
+        # one input, one output: the input's share of the weight is the whole minus the 10-byte frame and the output
+        input_weight = mined["weight"] - 2 - 4 * (10 + 8 + 1 + len(self.wallet.get_output_script()))
+        self.log.info("input weight %d WU (paper: 3,904)" % input_weight)
+        assert_equal(input_weight, 3904)
+        # the whole spend, with MiniWallet's 34-byte output script
+        assert_equal(len(self.wallet.get_output_script()), 34)
+        assert_equal(mined["weight"], 4118)
+        assert_equal(mined["vsize"], 1030)
+
+        # 2. The soft-fork property: node1 (old rules) accepts a block carrying a BAD signature; node0 rejects it.
+        bad = self.spend(PQKey(), 2 * COIN, flip_sig_byte=7)
+        self.sync_blocks()
+        block = self.block_with(node1, bad)
+        assert_equal(node1.submitblock(block.serialize().hex()), None)
+        assert_equal(node1.getbestblockhash(), block.hash_hex)
+        assert_equal(node0.submitblock(block.serialize().hex()), "block-script-verify-flag-failed (PQ signature is invalid)")
+        assert node0.getbestblockhash() != block.hash_hex
+        self.log.info("bad-signature block: accepted by the old-rules node, rejected by the upgraded node")
+        # bring node1 back to node0's chain for the rest
+        node1.invalidateblock(block.hash_hex)
+        self.sync_blocks()
+
+        # 3. Mutations at node0's mempool door, each with the opcode's own error.
+        key2 = PQKey()
+        good = self.spend(key2, 2 * COIN)
+        flipped = self.spend(PQKey(), 2 * COIN, flip_sig_byte=1)
+        assert_raises_rpc_error(-26, "PQ signature is invalid", node0.sendrawtransaction, flipped.serialize().hex())
+        wrong_key = self.spend(PQKey(), 2 * COIN, keyblob=key.keyblob)
+        assert_raises_rpc_error(-26, "does not hash to the witness program", node0.sendrawtransaction, wrong_key.serialize().hex())
+        three = self.spend(PQKey(), 2 * COIN)
+        three.wit.vtxinwit[0].scriptWitness.stack.append(b"\x01")
+        res = node0.testmempoolaccept([three.serialize().hex()])[0]
+        assert_equal(res["allowed"], False)
+        assert "Witness program hash mismatch" in res["reject-reason"]
+        node0.sendrawtransaction(good.serialize().hex())
+        blockhash = self.generate(node0, 1)[0]
+        assert_equal(node0.getrawtransaction(good.txid_hex, True, blockhash)["confirmations"], 1)
+
+        # 4. Dust is priced from the real spend: a 1,000-sat PQ output is dust, a 1,000-sat P2WPKH output is not.
+        tiny = self.wallet.create_self_transfer()["tx"]
+        tiny.vout[0].nValue -= 1000
+        tiny.vout.append(CTxOut(1000, PQKey().spk))
+        res = node0.testmempoolaccept([tiny.serialize().hex()])[0]
+        assert_equal(res["allowed"], False)
+        assert_equal(res["reject-reason"], "dust")
+        self.log.info("done at height %d" % node0.getblockcount())
+
+
+if __name__ == '__main__':
+    PQWitnessTest(__file__).main()
