diff --git a/src/crypto/mldsa44.cpp b/src/crypto/mldsa44.cpp
new file mode 100644
index 0000000..805c998
--- /dev/null
+++ b/src/crypto/mldsa44.cpp
@@ -0,0 +1,46 @@
+// Copyright (c) 2026 The Blazecoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <crypto/mldsa44.h>
+
+extern "C" {
+#include <crypto/mldsa/params.h>
+#include <crypto/mldsa/sign.h>
+}
+
+namespace mldsa44 {
+
+static_assert(PUBKEY_SIZE == CRYPTO_PUBLICKEYBYTES, "vendored ML-DSA is not mode 2");
+static_assert(SECKEY_SIZE == CRYPTO_SECRETKEYBYTES, "vendored ML-DSA is not mode 2");
+static_assert(SIG_SIZE == CRYPTO_BYTES, "vendored ML-DSA is not mode 2");
+static_assert(SEED_SIZE == SEEDBYTES, "unexpected seed size");
+
+bool KeyGenFromSeed(std::span<const unsigned char> seed32, std::vector<unsigned char>& pk, std::vector<unsigned char>& sk)
+{
+    if (seed32.size() != SEED_SIZE) return false;
+    pk.assign(PUBKEY_SIZE, 0);
+    sk.assign(SECKEY_SIZE, 0);
+    crypto_sign_keypair_from_seed(pk.data(), sk.data(), seed32.data());
+    return true;
+}
+
+bool Sign(std::span<const unsigned char> sk, std::span<const unsigned char> msg, std::span<const unsigned char> ctx, std::vector<unsigned char>& sig)
+{
+    if (sk.size() != SECKEY_SIZE || ctx.size() > MAX_CTX_SIZE) return false;
+    sig.assign(SIG_SIZE, 0);
+    size_t siglen = 0;
+    if (crypto_sign_signature(sig.data(), &siglen, msg.data(), msg.size(), ctx.data(), ctx.size(), sk.data()) != 0 || siglen != SIG_SIZE) {
+        sig.clear();
+        return false;
+    }
+    return true;
+}
+
+bool Verify(std::span<const unsigned char> pk, std::span<const unsigned char> msg, std::span<const unsigned char> ctx, std::span<const unsigned char> sig)
+{
+    if (pk.size() != PUBKEY_SIZE || sig.size() != SIG_SIZE || ctx.size() > MAX_CTX_SIZE) return false;
+    return crypto_sign_verify(sig.data(), sig.size(), msg.data(), msg.size(), ctx.data(), ctx.size(), pk.data()) == 0;
+}
+
+} // namespace mldsa44
diff --git a/src/crypto/mldsa44.h b/src/crypto/mldsa44.h
new file mode 100644
index 0000000..1bee9f0
--- /dev/null
+++ b/src/crypto/mldsa44.h
@@ -0,0 +1,35 @@
+// Copyright (c) 2026 The Blazecoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_CRYPTO_MLDSA44_H
+#define BITCOIN_CRYPTO_MLDSA44_H
+
+#include <cstddef>
+#include <span>
+#include <vector>
+
+/** ML-DSA-44 (NIST FIPS 204) over the vendored pq-crystals reference implementation in crypto/mldsa/.
+ *  Deterministic signing (rnd = 0), seeded key generation, no RNG linked into consensus code. The same wrapper
+ *  has been live on Blazecoin's main chain since September 2026. */
+namespace mldsa44 {
+
+constexpr size_t PUBKEY_SIZE = 1312;
+constexpr size_t SECKEY_SIZE = 2560;
+constexpr size_t SIG_SIZE = 2420;
+constexpr size_t SEED_SIZE = 32;
+/** FIPS 204: the context string is at most 255 bytes. */
+constexpr size_t MAX_CTX_SIZE = 255;
+
+/** Expand a 32-byte seed into a key pair (FIPS 204 ML-DSA.KeyGen_internal). */
+bool KeyGenFromSeed(std::span<const unsigned char> seed32, std::vector<unsigned char>& pk, std::vector<unsigned char>& sk);
+
+/** Deterministic signature over msg under the context string ctx. */
+bool Sign(std::span<const unsigned char> sk, std::span<const unsigned char> msg, std::span<const unsigned char> ctx, std::vector<unsigned char>& sig);
+
+/** Verify sig over msg under ctx with public key pk. */
+bool Verify(std::span<const unsigned char> pk, std::span<const unsigned char> msg, std::span<const unsigned char> ctx, std::span<const unsigned char> sig);
+
+} // namespace mldsa44
+
+#endif // BITCOIN_CRYPTO_MLDSA44_H
