+/** The post-quantum witness version (script/pq.h) end to end: a key from a seed, an OP_2 <hash> output, a
+ *  two-item witness, the BIP-341-shaped message under its own tag, the weight of the spend. */
+BOOST_FIXTURE_TEST_SUITE(pq_witness_tests, BasicTestingSetup)
+
+namespace {
+
+struct Spend {
+    std::vector<unsigned char> pk, sk, keyblob, sig;
+    CScript spk;
+    CMutableTransaction tx;
+    CAmount amount{5 * COIN};
+    std::vector<CTxOut> spent;
+
+    explicit Spend(unsigned char seedbyte = 0x11)
+    {
+        const std::vector<unsigned char> seed(32, seedbyte);
+        BOOST_REQUIRE(mldsa44::KeyGenFromSeed(seed, pk, sk));
+        keyblob = pq::PQKeyBlob(pk);
+        spk = pq::GetScriptForPQWitness(pq::PQKeyHash(keyblob));
+        tx.version = 2;
+        tx.vin.resize(1);
+        tx.vin[0].prevout = COutPoint(Txid::FromUint256(uint256::ONE), 0);
+        tx.vin[0].nSequence = 0xfffffffd;
+        tx.vout.resize(1);
+        tx.vout[0].nValue = amount - 1000;
+        tx.vout[0].scriptPubKey = CScript() << OP_TRUE;
+        tx.nLockTime = 0;
+        spent = {CTxOut{amount, spk}};
+        Sign();
+    }
+
+    PrecomputedTransactionData Data() const
+    {
+        PrecomputedTransactionData txdata;
+        txdata.Init(tx, std::vector<CTxOut>{spent}, /*force=*/true);
+        return txdata;
+    }
+
+    void Sign()
+    {
+        uint256 digest;
+        BOOST_REQUIRE(pq::SignatureHashPQ(digest, tx, 0, Data()));
+        BOOST_REQUIRE(mldsa44::Sign(sk, digest, pq::CtxTx(), sig));
+        Witness();
+    }
+
+    void Witness(const std::vector<unsigned char>* sig_override = nullptr, const std::vector<unsigned char>* keyblob_override = nullptr)
+    {
+        tx.vin[0].scriptWitness.stack = {sig_override ? *sig_override : sig, keyblob_override ? *keyblob_override : keyblob};
+    }
+
+    /** The transaction's own checker; txdata must outlive it. */
+    MutableTransactionSignatureChecker Checker(const PrecomputedTransactionData& txdata) const
+    {
+        return MutableTransactionSignatureChecker(&tx, 0, amount, txdata, MissingDataBehavior::FAIL);
+    }
+
+    ScriptError VerifyWith(const BaseSignatureChecker& checker, script_verify_flags flags) const
+    {
+        ScriptError err = SCRIPT_ERR_OK;
+        const bool ok = VerifyScript(CScript(), spk, &tx.vin[0].scriptWitness, flags, checker, &err);
+        BOOST_CHECK_EQUAL(ok, err == SCRIPT_ERR_OK); // a failure must name its error
+        return err;
+    }
+
+    ScriptError Verify(script_verify_flags flags) const
+    {
+        const PrecomputedTransactionData txdata = Data();
+        return VerifyWith(Checker(txdata), flags);
+    }
+};
+
+const script_verify_flags NEW_RULES = STANDARD_SCRIPT_VERIFY_FLAGS;                             // includes SCRIPT_VERIFY_PQ
+const script_verify_flags OLD_NODE = SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_TAPROOT; // consensus rules without the soft fork
+
+std::string Err(ScriptError e) { return ScriptErrorString(e); }
+
+} // namespace
+
+BOOST_AUTO_TEST_CASE(honest_spend_verifies_and_is_anyone_can_spend_to_an_old_node)
+{
+    Spend s;
+    BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_OK));
+    BOOST_CHECK_EQUAL(Err(s.Verify(MANDATORY_SCRIPT_VERIFY_FLAGS | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_PQ)), Err(SCRIPT_ERR_OK));
+    // Without the rule: an unknown witness version, valid to consensus, discouraged by policy.
+    BOOST_CHECK_EQUAL(Err(s.Verify(OLD_NODE)), Err(SCRIPT_ERR_OK));
+    BOOST_CHECK_EQUAL(Err(s.Verify(OLD_NODE | SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM)), Err(SCRIPT_ERR_DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM));
+    // Sizes and weight, for the paper: 34-byte output; witness 3,740 bytes; input weight 3,904 WU.
+    BOOST_CHECK_EQUAL(s.spk.size(), 34U);
+    BOOST_CHECK_EQUAL(GetSerializeSize(s.tx.vin[0].scriptWitness.stack), pq::PQ_WITNESS_SERIALIZED_SIZE);
+    const CTransaction ctx(s.tx);
+    const int64_t weight = GetTransactionWeight(ctx);
+    const int64_t base = GetSerializeSize(TX_NO_WITNESS(ctx));
+    const int64_t input_weight = weight - (base - 41) * WITNESS_SCALE_FACTOR - 2 /* marker+flag */;
+    BOOST_TEST_MESSAGE("PQ witness spend: weight " << weight << " WU, vsize " << GetVirtualTransactionSize(ctx) << " vB, input weight " << input_weight << " WU");
+    BOOST_CHECK_EQUAL(input_weight, 3904);
+    // The whole one-input spend here pays to a one-byte output script: 61 non-witness bytes, marker and flag, the witness.
+    BOOST_CHECK_EQUAL(weight, 3986);
+    BOOST_CHECK_EQUAL(GetVirtualTransactionSize(ctx), 997);
+}
+
+BOOST_AUTO_TEST_CASE(every_mutation_fails_with_its_own_error)
+{
+    {   // a byte of the signature
+        Spend s; auto bad = s.sig; bad[100] ^= 0x01; s.Witness(&bad);
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_PQ_SIG_INVALID));
+    }
+    {   // a different amount in the spent output: the message commits to it
+        Spend s; s.spent[0].nValue += 1;
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_PQ_SIG_INVALID));
+    }
+    {   // another key behind the hash
+        Spend s, other(0x22); s.Witness(nullptr, &other.keyblob);
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_PQ_KEYHASH_MISMATCH));
+    }
+    {   // a reserved algorithm id, committed to by the hash: inactive
+        Spend s; s.keyblob[0] = 0x02; s.spk = pq::GetScriptForPQWitness(pq::PQKeyHash(s.keyblob)); s.spent[0].scriptPubKey = s.spk; s.Witness();
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_PQ_ALGO_INACTIVE));
+    }
+    {   // a short key blob, committed to by the hash
+        Spend s; s.keyblob.pop_back(); s.spk = pq::GetScriptForPQWitness(pq::PQKeyHash(s.keyblob)); s.spent[0].scriptPubKey = s.spk; s.Witness();
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_PQ_PUBKEY_LENGTH));
+    }
+    {   // a short signature
+        Spend s; auto bad = s.sig; bad.pop_back(); s.Witness(&bad);
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_PQ_SIG_INVALID));
+    }
+    {   // three witness items, one item
+        Spend s; s.tx.vin[0].scriptWitness.stack.push_back({0x01});
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_WITNESS_PROGRAM_MISMATCH));
+        s.tx.vin[0].scriptWitness.stack = {s.sig};
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_WITNESS_PROGRAM_MISMATCH));
+    }
+    {   // an output changed after signing
+        Spend s; s.tx.vout[0].nValue -= 1;
+        BOOST_CHECK_EQUAL(Err(s.Verify(NEW_RULES)), Err(SCRIPT_ERR_PQ_SIG_INVALID));
+    }
+    {   // a non-empty scriptSig with a native witness program
+        Spend s;
+        ScriptError err = SCRIPT_ERR_OK;
+        const PrecomputedTransactionData txdata = s.Data();
+        VerifyScript(CScript() << OP_1, s.spk, &s.tx.vin[0].scriptWitness, NEW_RULES,
+                     MutableTransactionSignatureChecker(&s.tx, 0, s.amount, txdata, MissingDataBehavior::FAIL), &err);
+        BOOST_CHECK_EQUAL(Err(err), Err(SCRIPT_ERR_WITNESS_MALLEATED));
+    }
+}
+
+BOOST_AUTO_TEST_CASE(a_deferring_checker_forwards_the_pq_check)
+{
+    // DeferringSignatureChecker wraps another checker (the signature extractor in script/sign.cpp, the weight
+    // checker in the wallet). It has to pass the post-quantum check on, result and error both; left to the base
+    // class it answers false for every spend.
+    Spend s;
+    const PrecomputedTransactionData txdata = s.Data();
+    const MutableTransactionSignatureChecker inner = s.Checker(txdata);
+    const DeferringSignatureChecker wrapped(inner);
+
+    // Through the interpreter: the same verdict as the checker it wraps.
+    BOOST_CHECK_EQUAL(Err(s.VerifyWith(inner, NEW_RULES)), Err(SCRIPT_ERR_OK));
+    BOOST_CHECK_EQUAL(Err(s.VerifyWith(wrapped, NEW_RULES)), Err(SCRIPT_ERR_OK));
+
+    // Called directly: true for the honest signature, with the error left alone.
+    ScriptError err = SCRIPT_ERR_OK;
+    BOOST_CHECK(wrapped.CheckPQSignature(s.sig, s.keyblob, &err));
+    BOOST_CHECK_EQUAL(Err(err), Err(SCRIPT_ERR_OK));
+
+    // A failure comes back with the wrapped checker's own error, not a bare false.
+    auto bad = s.sig; bad[100] ^= 0x01;
+    BOOST_CHECK(!wrapped.CheckPQSignature(bad, s.keyblob, &err));
+    BOOST_CHECK_EQUAL(Err(err), Err(SCRIPT_ERR_PQ_SIG_INVALID));
+    s.Witness(&bad);
+    BOOST_CHECK_EQUAL(Err(s.VerifyWith(wrapped, NEW_RULES)), Err(SCRIPT_ERR_PQ_SIG_INVALID));
+    s.Witness();
+
+    // Two layers of wrapping still reach the real check.
+    const DeferringSignatureChecker twice(wrapped);
+    BOOST_CHECK_EQUAL(Err(s.VerifyWith(twice, NEW_RULES)), Err(SCRIPT_ERR_OK));
+
+    // The base class has no transaction to check against: false, and it sets no error of its own.
+    const BaseSignatureChecker base;
+    err = SCRIPT_ERR_OK;
+    BOOST_CHECK(!base.CheckPQSignature(s.sig, s.keyblob, &err));
+    BOOST_CHECK_EQUAL(Err(err), Err(SCRIPT_ERR_OK));
+    BOOST_CHECK(!DeferringSignatureChecker(base).CheckPQSignature(s.sig, s.keyblob));
+}
+
+BOOST_AUTO_TEST_CASE(message_and_dust)
+{
+    Spend s;
+    uint256 a, b;
+    BOOST_REQUIRE(pq::SignatureHashPQ(a, s.tx, 0, s.Data()));
+    s.tx.nLockTime = 1;
+    BOOST_REQUIRE(pq::SignatureHashPQ(b, s.tx, 0, s.Data()));
+    BOOST_CHECK(a != b);
+    PrecomputedTransactionData empty;
+    BOOST_CHECK(!pq::SignatureHashPQ(b, s.tx, 0, empty)); // needs the BIP-341 data and the spent outputs
+    // Dust is priced from the real spend size, (43 + 41 + 3740/4) bytes at 3 sat per byte: far above the 294 sat of
+    // other witness outputs.
+    const CFeeRate dust_rate{DUST_RELAY_TX_FEE};
+    const CAmount pq_dust = GetDustThreshold(CTxOut{0, s.spk}, dust_rate);
+    const CAmount p2wpkh_dust = GetDustThreshold(CTxOut{0, CScript() << OP_0 << std::vector<unsigned char>(20, 1)}, dust_rate);
+    BOOST_TEST_MESSAGE("dust threshold: PQ output " << pq_dust << " sat, P2WPKH " << p2wpkh_dust << " sat");
+    BOOST_CHECK_EQUAL(pq_dust, 3057);
+    BOOST_CHECK_EQUAL(p2wpkh_dust, 294);
+}
+
+BOOST_AUTO_TEST_CASE(script_pubkey_shape_is_stated_once)
+{
+    // The output's byte shape: OP_2 and one 32-byte push, nothing else.
+    const Spend s;
+    BOOST_CHECK(pq::IsPQScriptPubKey(s.spk));
+    BOOST_CHECK_EQUAL(s.spk.size(), 34U);
+    const std::vector<unsigned char> h32(32, 0x42), h20(20, 0x42), h33(33, 0x42);
+    BOOST_CHECK(pq::IsPQScriptPubKey(CScript() << OP_2 << h32));
+    BOOST_CHECK(!pq::IsPQScriptPubKey(CScript() << OP_1 << h32));   // Taproot
+    BOOST_CHECK(!pq::IsPQScriptPubKey(CScript() << OP_0 << h20));   // P2WPKH
+    BOOST_CHECK(!pq::IsPQScriptPubKey(CScript() << OP_0 << h32));   // P2WSH
+    BOOST_CHECK(!pq::IsPQScriptPubKey(CScript() << OP_2 << h33));   // version 2, wrong program length
+    BOOST_CHECK(!pq::IsPQScriptPubKey(CScript() << OP_2 << h20));
+    BOOST_CHECK(!pq::IsPQScriptPubKey(CScript() << OP_2 << h32 << OP_TRUE));   // trailing opcode
+    BOOST_CHECK(!pq::IsPQScriptPubKey(CScript()));
+}
+
+BOOST_AUTO_TEST_SUITE_END()
